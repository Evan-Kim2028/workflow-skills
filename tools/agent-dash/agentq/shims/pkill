#!/bin/sh
# agentq PATH shim for pkill: always refused for workers. A pattern-wide kill on a shared laptop hits other agents and the owner's apps (2026-11-14: `pkill -f "x" -P 1` on macOS read "1" as a pattern and SIGTERMed every process with a 1 in its command line).
if [ "${AGENTQ_GUARD:-1}" = 0 ]; then
    case $0 in */*) SHIM_HERE=${0%/*} ;; *) SHIM_HERE=. ;; esac
    . "$SHIM_HERE/shim-lib.sh"
    shim_real pkill || exit 127
    exec "$REAL" "$@"
fi
_log=${AGENTQ_HOME:-$HOME/.local/state/agentq}/guard_blocks.tsv
_cmd=$(printf '%s ' pkill "$@" | cut -c1-300)
printf '%s\t%s\t%s\t%s\n' "$(date +%s)" "${AGENTQ_RUN:-${AGENTQ_JOB:--}}" "pkill refused" "$_cmd" >> "$_log" 2>/dev/null
echo "BLOCKED: agentq guard: pkill refused; it can kill other agents and the owner's apps. Kill only your own processes by PID: for p in \$(pgrep -f '[m]y-exact-pattern'); do kill \$p; done" >&2
exit 2
