#!/bin/sh
# agentq PATH shim for rg: refuses a search whose root is a broad folder (the system roots, the home folder, its projects or worktrees collection, or a child of the worktrees collection). The root check is POSIX sh only; rg over a specific folder execs the real binary.
case $0 in */*) SHIM_HERE=${0%/*} ;; *) SHIM_HERE=. ;; esac
. "$SHIM_HERE/shim-lib.sh"
if [ "${AGENTQ_GUARD:-1}" != 0 ]; then
    _nl='
'
    _pat=
    _files=
    _skip=
    _dashes=
    _pos=
    for _arg in "$@"; do
        if [ -n "$_skip" ]; then
            _skip=
            continue
        fi
        if [ -z "$_dashes" ]; then
            case $_arg in
                --) _dashes=1; continue ;;
                -e|--regexp|-f|--file) _pat=1; _skip=1; continue ;;
                --files) _files=1; continue ;;
                -g|-t|-T|-m|-A|-B|-C|-j|-M|-r|-d|-E) _skip=1; continue ;;
                --glob|--iglob|--type|--type-not|--type-add|--type-clear|--max-count|--after-context|--before-context|--context|--threads|--max-columns|--replace|--max-depth|--sort|--sortr|--pre|--pre-glob|--encoding|--colors|--context-separator|--engine|--max-filesize|--ignore-file|--path-separator|--dfa-size-limit|--regex-size-limit|--field-context-separator|--field-match-separator|--generate)
                    _skip=1; continue ;;
                -*) continue ;;
            esac
        fi
        _pos="$_pos$_arg$_nl"
    done
    if [ -z "$_pat" ] && [ -z "$_files" ]; then
        _pos=${_pos#*"$_nl"}
    fi
    [ -n "$_pos" ] || _pos=.$_nl
    while IFS= read -r _root; do
        [ -n "$_root" ] || continue
        shim_check_root rg "$_root" "$@"
    done <<ROOTS
$_pos
ROOTS
fi
shim_real rg || exit 127
exec "$REAL" "$@"
