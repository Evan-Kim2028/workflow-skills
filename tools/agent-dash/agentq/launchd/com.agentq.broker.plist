<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the agentq broker LaunchAgent. Not installed by this repo.
  Replace __PYTHON__ (absolute interpreter path) and __HOME__ (the user's home
  directory) before copying it to ~/Library/LaunchAgents/com.agentq.broker.plist.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentq.broker</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>agentq.cli</string>
        <string>daemon</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__HOME__/.claude/tools/agent-dash</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>AGENTQ_HOME</key>
        <string>__HOME__/.local/state/agentq</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__HOME__/.local/state/agentq/logs/broker.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.local/state/agentq/logs/broker.launchd.log</string>
</dict>
</plist>
