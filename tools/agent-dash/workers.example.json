{
  "default": "muse",
  "auto_order": ["muse", "glm-flash", "codex-luna", "pi-deepseek-flash"],
  "cooldown_minutes": 30,
  "workers": {
    "muse": {
      "enabled": true,
      "kind": "muse",
      "model": "muse-spark-1.3-contributor",
      "extra_args": ["--trust-workspace", "--reasoning-effort", "xhigh", "--disable-reminders", "--user-input-auto-resolve"],
      "cap": 25,
      "pgrep": "[m]use-bin|[m]use exec",
      "manifest": "muse-sessions.tsv",
      "columns": ["label", "session_id", "epoch", "model"],
      "quota_patterns": ["rate limit", "quota", "429", "usage limit"],
      "cost_rank": 1
    },
    "grok": {
      "enabled": true,
      "kind": "cursor",
      "model": "grok-4.7[context=500k,reasoning_effort=xhigh,fast=false]",
      "extra_args": [],
      "cap": 25,
      "pgrep": "[c]ursor-agent",
      "manifest": "cursor-sessions.tsv",
      "columns": ["label", "session_id", "epoch", "model"],
      "quota_patterns": ["rate limit", "quota", "429", "usage limit"],
      "cost_rank": 4
    },
    "deepseek-flash": {
      "enabled": true,
      "kind": "grok-build",
      "model": "deepseek-flash",
      "extra_args": [],
      "cap": 5,
      "pgrep": "-m [d]eepseek-flash",
      "manifest": "glm-sessions.tsv",
      "columns": ["label", "session_id", "epoch", "model"],
      "quota_patterns": ["rate limit", "quota", "429", "usage limit", "rate limit reached for requests"],
      "cost_rank": 2
    },
    "glm": {
      "enabled": true,
      "kind": "grok-build",
      "model": "glm-5.3",
      "extra_args": [],
      "cap": 2,
      "pgrep": "-m [g]lm-5.3($| )",
      "manifest": "glm-sessions.tsv",
      "columns": ["label", "session_id", "epoch", "model"],
      "quota_patterns": ["rate limit", "quota", "429", "usage limit", "rate limit reached for requests"],
      "cost_rank": 3
    },
    "glm-flash": {
      "enabled": true,
      "kind": "grok-build",
      "model": "glm-5.3-flash",
      "extra_args": [],
      "cap": 5,
      "pgrep": "-m [g]lm-5.3-flash",
      "manifest": "glm-sessions.tsv",
      "columns": ["label", "session_id", "epoch", "model"],
      "quota_patterns": ["rate limit", "quota", "429", "usage limit", "rate limit reached for requests"],
      "cost_rank": 2
    },
    "pi-deepseek": {
      "enabled": true,
      "kind": "pi",
      "model": "river/deepseek-ai/DeepSeek-V4.1-Flash-1017",
      "extra_args": [],
      "cap": 12,
      "pgrep": "[l]aunch_pi.py.*--model river/deepseek-ai/DeepSeek-V4.1-Flash-1017",
      "manifest": "pi-sessions.tsv",
      "columns": ["label", "session_id", "epoch", "model"],
      "quota_patterns": ["rate limit", "quota", "429", "usage limit", "insufficient credits"],
      "cost_rank": 2
    },
    "pi-beam": {
      "enabled": true,
      "kind": "pi",
      "model": "reflection/Beam-1.0-501B-A23B",
      "extra_args": [],
      "cap": 5,
      "pgrep": "[l]aunch_pi.py.*--model reflection/Beam-1.0-501B-A23B",
      "manifest": "pi-sessions.tsv",
      "columns": ["label", "session_id", "epoch", "model"],
      "quota_patterns": ["rate limit", "quota", "429", "usage limit", "insufficient credits"],
      "cost_rank": 3
    },
    "codex-luna": {
      "enabled": true,
      "kind": "codex",
      "model": "gpt-6-luna",
      "extra_args": ["--reasoning-effort", "xhigh"],
      "cap": 3,
      "pgrep": "[l]aunch_codex.py.*--tier codex-luna",
      "manifest": "codex-sessions.tsv",
      "columns": ["label", "session_id", "epoch", "model"],
      "quota_patterns": ["rate limit", "quota", "429", "usage limit"],
      "cost_rank": 5
    },
    "pi-deepseek-flash": {
      "enabled": true,
      "kind": "pi",
      "model": "river/deepseek-ai/DeepSeek-V4.1-Flash-1017",
      "extra_args": [],
      "cap": 5,
      "pgrep": "[l]aunch_pi.py.*--tier pi-deepseek-flash",
      "manifest": "pi-sessions.tsv",
      "columns": ["label", "session_id", "epoch", "model"],
      "quota_patterns": ["rate limit", "quota", "429", "usage limit", "insufficient credits"],
      "cost_rank": 6
    }
  }
}
